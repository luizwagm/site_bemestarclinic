# ==========================================================================
#  Modelo do .env — COPIE para `.env` e preencha. O .env não entra no git.
#
#  Em PRODUÇÃO não se usa este arquivo: as variáveis vêm do systemd, por
#  EnvironmentFile=/etc/bemestar.env (root:root, chmod 600). Ver DEPLOY.md.
#
#  Só o sistema de gestão (/restrito) usa o PostgreSQL. O site e o /admin
#  continuam no SQLite em data/site.db, que não precisa de configuração.
# ==========================================================================

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=bemestar
PGPASSWORD=troque-esta-senha
PGDATABASE=bemestar_gestao

# Alternativa: uma URL só, que tem prioridade sobre as variáveis acima.
# DATABASE_URL=postgresql://bemestar:senha@127.0.0.1:5432/bemestar_gestao

# Quantas conexões o pool mantém. 10 é folgado para a clínica inteira.
# PGPOOL_MAX=10

# Backup automático (vale para os dois bancos)
# BACKUP_HORAS=24
# BACKUP_MANTER=30

# ==========================================================================
#  CHAVE DOS DADOS SENSÍVEIS (obrigatória)
#  Cifra CPF, RG, endereço, telefone, e-mail, anamnese e prontuário no banco.
#  Gere com:  openssl rand -base64 32
#
#  PERDER ESTA CHAVE TORNA OS DADOS ILEGÍVEIS — nem o backup salva.
#  Guarde uma cópia FORA do servidor, junto dos backups.
# ==========================================================================
DADOS_CHAVE=cole-aqui-32-bytes-em-base64

# Só durante uma troca de chave: mantém a leitura do que foi escrito com a antiga.
# DADOS_CHAVE_ANTERIOR=

# ==========================================================================
#  LA SENTINELA — monitoramento (opcional)
#  Sem SENT_SEGREDO o conector fica INATIVO e avisa no boot; o site segue
#  normal. O segredo é o mesmo cadastrado no gerenciador, na ficha do site.
#
#  NUNCA escreva o segredo no server.js: este repositório é PÚBLICO, e o que
#  entra no histórico do git não sai mais.
# ==========================================================================
SENT_URL=http://localhost:5191
SENT_SITE=1
SENT_SEGREDO=

# ==========================================================================
#  LA CHAT — o chat da equipe dentro do /restrito (opcional)
#
#  Sem `CHAT_SEGREDO_PASSE` o conector fica INATIVO, avisa no boot e as rotas
#  do chat somem. O resto do sistema não muda de comportamento.
#
#  O segredo é o MESMO dos dois lados: aqui e no `/etc/lachat.env` do serviço
#  do chat. Se divergirem, o passe é recusado com "assinatura inválida" — que
#  é de propósito: uma divergência que falhasse em silêncio seria pior.
#
#  Gere com:  openssl rand -base64 32     (mínimo 32 caracteres; o conector
#                                          RECUSA subir com um segredo curto)
#
#  ATENÇÃO ao nginx: o WebSocket exige o bloco `location /restrito/chat/ws`
#  (ver nginx/bemestarclinic.com.conf) e o `map` em conf.d. Sem eles o chat
#  autentica e nunca recebe mensagem em tempo real, sem erro visível.
# ==========================================================================
CHAT_URL=http://127.0.0.1:5197
CHAT_SEGREDO_PASSE=
